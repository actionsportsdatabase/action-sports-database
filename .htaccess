# ── ACTION SPORTS DATABASE — BLUEHOST APACHE CONFIG ──────────────

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Redirect alternate domains to the live primary domain
RewriteCond %{HTTP_HOST} ^(www\.)?actionsportsdatabase\.com$ [NC]
RewriteRule ^(.*)$ https://actionsportsdb.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?actionsportdatabase\.com$ [NC]
RewriteRule ^(.*)$ https://actionsportsdb.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?actionsportdb\.com$ [NC]
RewriteRule ^(.*)$ https://actionsportsdb.com/$1 [R=301,L]

# SPA routing — serve index.html for all non-file requests
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]

# ── CACHING ───────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML — never cache the application shell. ASDB publishes frequently and
  # stale index.html files can point visitors at an entire previous release.
  ExpiresByType text/html              "access plus 0 seconds"
  # JS/CSS — longer cache (fingerprint if you update)
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/css              "access plus 7 days"
  # Images
  ExpiresByType image/png             "access plus 30 days"
  ExpiresByType image/svg+xml         "access plus 30 days"
</IfModule>

# ── COMPRESSION ───────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# ── SECURITY HEADERS ──────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html?$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

# ── BLOCK SENSITIVE FILES ─────────────────────────────────────────
<FilesMatch "\.(log|env|git|bak|sh)$">
  Order allow,deny
  Deny from all
</FilesMatch>
